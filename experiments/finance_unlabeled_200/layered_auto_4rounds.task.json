{
  "version": 1,
  "task": {
    "name": "finance_query_classification",
    "input_fields": ["query"],
    "output_description": "依据给定 taxonomy 将金融 Query 分类为严格 JSON。"
  },
  "dataset": {
    "path": "../../artifacts/datasets/finance_unlabeled_200/finance_optimize_unlabeled_200.jsonl"
  },
  "signals": {
    "path": "../../artifacts/experiments/finance_unlabeled_200/signals.json"
  },
  "models": {
    "task_model": "deepseek-chat",
    "task_response_format": "json_object",
    "task_max_tokens": 2048,
    "judge_model": "deepseek-reasoner",
    "generator_model": "deepseek-chat",
    "base_url": "https://api.deepseek.com/v1"
  },
  "optimization": {
    "initial_prompt_path": "../../artifacts/experiments/finance_unlabeled_200/initial_prompt.md"
  },
  "plugin": {
    "name": "finance_classification",
    "taxonomy_path": "../../artifacts/experiments/finance_unlabeled_200/taxonomy.json"
  },
  "evaluation": {
    "mode": "layered_auto",
    "max_candidates": 2,
    "fixed_sample_kinds": ["boundary_probe"],
    "dynamic_top_k": 30,
    "judge_max_cases_per_prompt": 80,
    "human_review_top_k": 20,
    "task_model_max_calls": 10000,
    "judge_model_max_calls": 1200,
    "judge_workers": 3,
    "max_seconds": 28800,
    "max_rounds": 4,
    "stop_after_no_improvement": 2,
    "minimum_improvement": 0.01,
    "retain_risk_memory": true,
    "first_round_hard_failure_stop_count": 196
  },
  "runs_dir": "../../artifacts/runs/finance_layered",
  "metadata": {
    "experiment": "finance_unlabeled_200_json_output_4rounds",
    "label_claim": "provisional_silver_or_unlabeled",
    "sample_design": "150 random_pool + 50 boundary_probe",
    "held_out_policy": "held_out_400 excluded from optimization",
    "early_stop": "stop after round 0 when champion hard_failure_count equals 196"
  }
}
